# Git
# .git is NOT ignored: hugo.toml sets enableGitInfo, so Hugo needs the repo to
# resolve commit dates for sitemap lastmod. Without it the build fails outright.
# Only the hugo-builder stage sees it; it never reaches the final image.
.gitignore

# Hugo build output
public/
resources/_gen/

# Development
.hugo_build.lock
.env

# Docker
docker-compose.yml
.dockerignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# API binary
api/contact-api

# Documentation (not needed in image)
*.md
!api/README.md
